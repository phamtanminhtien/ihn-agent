{
  "name": "ihn-agent-monorepo",
  "version": "1.0.0",
  "description": "Intelligent Helper Node - An open-source agentic AI coding assistant",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "prepare": "husky",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint --fix",
    "format": "prettier --write .",
    "type-check": "tsc --build",
    "cli:dev": "pnpm --filter ihn-agent dev",
    "cli:build": "pnpm --filter ihn-agent build",
    "cli:start": " pnpm --filter ihn-agent start",
    "build": "pnpm -r build"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-assistant",
    "llm",
    "typescript",
    "cli"
  ],
  "author": "IHN Agent Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phamtanminhtien/ihn-agent.git"
  },
  "bugs": {
    "url": "https://github.com/phamtanminhtien/ihn-agent/issues"
  },
  "homepage": "https://github.com/phamtanminhtien/ihn-agent#readme",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.21.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
