{
  "name": "@ihn-agent/providers",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "LLM provider adapters for IHN Agent",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "start": "tsup src/index.ts --format esm --dts",
    "type-check": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@google/generative-ai": "^0.24.1",
    "@ihn-agent/types": "workspace:*",
    "openai": "^4.82.0"
  }
}
