{
  "name": "@ihn-agent/tools",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Built-in tools for IHN Agent",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "type-check": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ihn-agent/types": "workspace:*"
  }
}
