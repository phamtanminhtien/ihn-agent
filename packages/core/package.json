{
  "name": "@ihn-agent/core",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Core agent orchestration and execution logic for IHN Agent",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@ihn-agent/types": "workspace:*"
  }
}
